      "roles": [
        {
          "description": "Seu lutador corpo a corpo vermelho e dourado, com fogo e silhueta original, precisa de animações visíveis de idle, caminhada, corrida, ataque, defesa, dano, esquiva, habilidade Explosão de Fogo, derrota e vitória.",
          "id": "capitao-brasa",
          "label": "Capitão Brasa — lutador 2D completo"
        },
        {
          "description": "Seu lutador veloz azul e ciano, com eletricidade e silhueta original, precisa de animações visíveis de idle, caminhada, corrida, ataque, defesa, dano, esquiva, habilidade Tempestade Elétrica, derrota e vitória.",
          "id": "raio-azul",
          "label": "Raio Azul — lutador 2D completo"
        },
        {
          "description": "Seu contra-atacante ágil de armadura escura e energia violeta precisa de animações visíveis de idle, caminhada, corrida, ataque, defesa, dano, esquiva, habilidade Corte das Sombras, derrota e vitória.",
          "id": "sombra-negra",
          "label": "Sombra Negra — lutador 2D completo"
        },
        {
          "description": "Seu guerreiro robusto de armadura dourada precisa de animações visíveis de idle, caminhada, corrida, ataque pesado, defesa, dano, esquiva, habilidade Impacto Titânico, derrota e vitória.",
          "id": "guardiao-dourado",
          "label": "Guardião Dourado — lutador 2D completo"
        },
        {
          "description": "Sua arena precisa sustentar leitura lateral do combate e versões horizontal e vertical, com arquibancadas, telões, iluminação dinâmica, profundidade e atmosfera, sem usar marcas ou artes protegidas.",
          "id": "arena-futurista",
          "label": "Arena futurista 2D de combate"
        },
        {
          "description": "Seus ataques, defesas, esquivas, críticos, combos, invulnerabilidade e quatro especiais precisam de efeitos sincronizados e distintos, mantendo boa leitura mesmo no modo transmissão.",
          "id": "efeitos-combate",
          "label": "Efeitos 2D de golpes e habilidades"
        },
        {
          "description": "Seus eventos de Rosa, Coração, presente de maior valor, Foguete, Coroa e multiplicadores precisam mostrar beneficiário e efeito aplicado, diferenciando claramente eventos simulados de eventos reais autorizados.",
          "id": "efeitos-presentes",
          "label": "Efeitos visuais 2D dos presentes"
        },
        {
          "description": "Sua interface em português do Brasil precisa comunicar nomes, vida, energia, rodada, cronômetro, placar, especiais, torcida, presentes, histórico e conexão real, com layouts legíveis em 1920×1080, 1080×1920, computador e celular.",
          "id": "hud-transmissao",
          "label": "HUD responsivo de combate e transmissão"
        }
      ]
    },
